<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Card: Shizuku connection + widget visibility + behaviour toggles -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_connection_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/status_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/checking_status"
                android:textSize="14sp"
                android:lineSpacingExtra="2dp"
                android:layout_marginBottom="16dp" />

            <Button
                android:id="@+id/action_button"
                style="@style/Widget.TilingWM.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/show_widget"
                android:visibility="gone" />

            <Button
                android:id="@+id/accessibility_button"
                style="@style/Widget.TilingWM.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/open_accessibility"
                android:visibility="gone"
                android:layout_marginTop="10dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="@color/divider" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/auto_restore_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_restore_title"
                android:textSize="15sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/auto_restore_hint"
                android:textColor="@color/on_background_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/rotation_reflow_switch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rotation_reflow_title"
                android:textSize="15sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/rotation_reflow_hint"
                android:textColor="@color/on_background_secondary"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />

        </LinearLayout>

        <!-- Card: Presets -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_presets_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_presets_hint"
                android:textColor="@color/on_background_secondary"
                android:textSize="12sp"
                android:layout_marginBottom="14dp" />

            <LinearLayout
                android:id="@+id/preset_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

        <!-- Card: Saved layouts -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_scenes_title"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/scene_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/no_scenes_saved"
                android:textColor="@color/on_background_secondary"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/scene_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
